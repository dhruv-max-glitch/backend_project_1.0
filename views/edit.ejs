<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="bg-zinc-900 min-h-screen">
    <div>
        <div class="m-4">
            <a href="/" class="text-blue-500">Back To Home</a>
        </div>
        <form action="/edit" method="post">
            <input name="previous" class="bg-zinc-800 block text-zinc-400 w-3/4 p-4 m-4 outline-none rounded-md"
                placeholder="Enter the title" value="<%= filename %>" readonly>
            <input name="new" class="bg-zinc-800 block text-white w-3/4 p-4 m-4 resize-none outline-none rounded-md" placeholder="New Title here...">
            <button type="submit" class="bg-yellow-400 text-white p-4 m-4 rounded-md">Update Task</button>
        </form>
    </div>
</body>

</html>